// Prisma schema — versión ML optimizada

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

// --- Enums ---------------------------------------------------

enum TransactionType {
  debit
  credit
}

enum BudgetPeriod {
  monthly
  weekly
  yearly
}

enum AlertType {
  budget_over
  anomaly
  recurring_due
  savings_rule_threshold // alerta por regla de ahorro / saldo mínimo
  gasto_hormiga          // NUEVO: alerta específica de gasto hormiga
}

enum AlertSource {
  system // lógica de negocio normal
  ml     // generado por modelo de machine learning
  user   // creado o confirmado manualmente
}

enum AccountType {
  CUENTA_CORRIENTE
  CUENTA_VISTA
  CUENTA_AHORRO
  TARJETA_CREDITO
}

enum Currency {
  CLP
  USD
  EUR
}

enum MlLabelSource {
  model    // etiqueta propuesta por el modelo
  manual   // etiqueta confirmada o cambiada por el usuario
  imported // traída desde el banco u otra fuente externa
}

// Nivel / severidad de la alerta
enum AlertLevel {
  INFO
  WARNING
  CRITICAL
}

// --- Modelos -------------------------------------------------

model User {
  id           String   @id @default(uuid())
  name         String
  email        String   @unique @db.VarChar(160)
  passwordHash String
  createdAt    DateTime @default(now()) @db.Timestamptz(6)
  rut          String?  @db.VarChar(16)
  phone        String?  @db.VarChar(24)

  // tokens de notificación push (Expo / FCM)
  pushTokens PushToken[]

  accounts     Account[]
  budgets      Budget[]
  alerts       Alert[]
  categories   Category[]
  savingsRules SavingsRule[]
}

model Account {
  id     String @id @default(uuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  bank          String
  accountType   AccountType
  accountNumber String
  holderName    String
  rutTitular    String?     @db.VarChar(16)

  alias       String?
  active      Boolean @default(true)
  provider    String?
  providerRef String?

  // Último saldo conocido (snapshot), útil para features de ML
  currency             Currency @default(CLP)
  balanceCents         Int      @default(0)
  creditLimitCents     Int? // para tarjetas de crédito
  availableCreditCents Int? // para tarjetas de crédito

  createdAt DateTime @default(now()) @db.Timestamptz(6)

  transactions Transaction[]
  savingsRules SavingsRule[]

  // alertas vinculadas a esta cuenta (saldo bajo, etc.)
  alerts Alert[]

  // presupuestos asociados a esta cuenta
  budgets Budget[]

  @@unique([userId, bank, accountType, accountNumber])
  @@index([userId])
}

model Category {
  id     String @id @default(uuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  name     String     @db.VarChar(80)
  parentId String?
  parent   Category?  @relation("CategoryHierarchy", fields: [parentId], references: [id])
  children Category[] @relation("CategoryHierarchy")
  color    String?

  // Categoría confirmada de la transacción (user / negocio)
  txs          Transaction[] @relation("TxCategory")
  // Categoría predicha por modelo de ML
  predictedTxs Transaction[] @relation("TxPredictedCategory")

  budgets Budget[]

  @@unique([userId, name])
  @@index([userId])
  @@index([parentId])
}

model Transaction {
  id        String  @id @default(uuid())
  accountId String
  account   Account @relation(fields: [accountId], references: [id], onDelete: Cascade)

  // Categoría confirmada (user / negocio)
  categoryId String?
  category   Category? @relation("TxCategory", fields: [categoryId], references: [id])

  // Categoría predicha por ML (puede diferir de categoryId hasta que el usuario confirme)
  mlPredictedCategoryId String?
  mlPredictedCategory   Category? @relation("TxPredictedCategory", fields: [mlPredictedCategoryId], references: [id])

  bookedAt    DateTime        @db.Timestamptz(6)
  postedAt    DateTime?       @db.Timestamptz(6)
  valueCents  Int
  type        TransactionType
  merchant    String?         @db.VarChar(120)
  description String?         @db.VarChar(240)

  // Campos pensados para ML / análisis avanzado
  anomalyScore      Float?
  isRecurring       Boolean @default(false)
  balanceAfterCents Int?
  externalId        String?

  // si el usuario ya revisó / descartó la anomalía
  anomalyResolved Boolean @default(false)

  // NUEVO: flag de gasto hormiga detectado por el modelo / reglas
  isGastoHormiga Boolean @default(false)

  // Metadatos ML
  mlLabelSource  MlLabelSource? // de dónde viene la etiqueta actual
  mlModelVersion String?        // versión de modelo que generó la predicción
  features       Json?          // features calculadas y cacheadas para entrenamiento/inferencia

  createdAt DateTime @default(now()) @db.Timestamptz(6)
  alerts    Alert[]

  @@unique([accountId, externalId])
  @@index([accountId, bookedAt(sort: Desc)])
  @@index([categoryId])
  @@index([mlPredictedCategoryId])
  @@index([isGastoHormiga])  // NUEVO: para filtrar rápido gastos hormiga
}

model Budget {
  id     String @id @default(uuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  accountId String
  account   Account @relation(fields: [accountId], references: [id], onDelete: Cascade)

  categoryId String
  category   Category @relation(fields: [categoryId], references: [id])

  amountCents Int
  period      BudgetPeriod @default(monthly)
  startMonth  DateTime     @db.Timestamptz(6)

  @@unique([userId, accountId, categoryId, period])
  @@index([accountId])
}

model Alert {
  id String @id @default(uuid())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Relación opcional con una transacción
  transactionId String?
  transaction   Transaction? @relation(fields: [transactionId], references: [id])

  // alerta asociada a una cuenta específica (ej: saldo bajo)
  accountId String?
  account   Account? @relation(fields: [accountId], references: [id])

  // alerta asociada a una regla de ahorro
  savingsRuleId String?
  savingsRule   SavingsRule? @relation(fields: [savingsRuleId], references: [id])

  type   AlertType
  source AlertSource @default(system)

  // nivel/severidad de la alerta
  level AlertLevel @default(WARNING)

  // mensaje legible para mostrar en el front
  message String? @db.VarChar(240)

  // JSON con datos adicionales (puede ser null si no necesitas payload)
  payload Json?

  createdAt DateTime  @default(now()) @db.Timestamptz(6)
  readAt    DateTime?

  // bandera para saber si sigue vigente (para badges, etc.)
  isActive Boolean @default(true)

  @@index([userId, createdAt])
  @@index([userId, isActive])
  @@index([accountId])
  @@index([savingsRuleId])
  @@index([type])
}


// Reglas de ahorro / umbrales de saldo por cuenta
model SavingsRule {
  id     String @id @default(uuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  accountId String
  account   Account @relation(fields: [accountId], references: [id])

  thresholdCents    Int // umbral duro (ej: 200.000)
  notifyMarginCents Int? // margen previo para avisar antes de llegar al umbral

  active    Boolean  @default(true)
  createdAt DateTime @default(now()) @db.Timestamptz(6)

  // alertas disparadas por esta regla
  alerts Alert[]

  @@index([userId, accountId])
}

// Tokens de push (Expo / FCM, etc.)
model PushToken {
  id     String @id @default(uuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  token    String  @db.VarChar(255)
  platform String? @db.VarChar(32)

  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)

  @@unique([userId, token], name: "user_token")
  @@index([userId])
}
